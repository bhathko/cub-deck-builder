{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ai/slide_spec.schema.json",
  "title": "Slide Spec",
  "description": "內容與渲染之間的中間層。LLM 只輸出這份 JSON（選 page_type + 填精確字串），不碰排版或畫圖。本檔做結構層驗證；每種 page_type 的槽位數量/字數/來源追溯等深層規則由 validate_slide_spec.py 執行。",
  "type": "object",
  "required": [
    "deck",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "deck": {
      "type": "object",
      "required": [
        "deck_name",
        "language",
        "slide_count"
      ],
      "additionalProperties": true,
      "properties": {
        "deck_name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "slide_count": {
          "type": "integer",
          "minimum": 1
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "模板包 id(gpts/templates/<id>/;省略等同 light)。id 是否存在與頁型支援由 validator/renderer 檢查。"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "required": [
        "number",
        "page_type",
        "title",
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "page_type": {
          "type": "string",
          "description": "必須是 validate_slide_spec.py 之 PAGE_TYPES 註冊表中的鍵；下列 enum 為目前已註冊者。新增版型時兩處都要加。",
          "enum": [
            "cover",
            "agenda",
            "closing",
            "vision_goal_center_balance",
            "info_three_column_category",
            "data_two_group_metric_comparison",
            "evaluation_option_score_pros_cons",
            "story_chapter_statement",
            "pyramid_layered_maturity_detail",
            "stage_dual_track_roadmap"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "render_page_number": {
          "type": "boolean"
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "background": {
              "type": "string"
            },
            "logo": {
              "type": "string"
            }
          }
        },
        "slots": {
          "type": "object",
          "description": "槽位形狀依 page_type 而定；深層規則（數量下上限、字數上限、來源追溯）在驗證器中執行。",
          "minProperties": 1
        }
      }
    }
  }
}
