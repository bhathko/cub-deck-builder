{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-ai/slide_spec.schema.json",
  "title": "Slide Spec",
  "description": "內容與渲染之間的中間層。LLM 只輸出這份 JSON（選 page_type + 填精確字串），不碰排版或畫圖。本檔做結構層驗證；每種 page_type 的槽位數量/字數/來源追溯等深層規則由 validate_slide_spec_gpts.py 執行。",
  "type": "object",
  "required": [
    "deck",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "deck": {
      "type": "object",
      "required": [
        "deck_name",
        "language",
        "slide_count"
      ],
      "additionalProperties": true,
      "properties": {
        "deck_name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "slide_count": {
          "type": "integer",
          "minimum": 1
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "模板包 id(engine/templates/<id>/;省略等同 light)。id 是否存在與頁型支援由 validator/renderer 檢查。"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "required": [
        "number",
        "page_type",
        "title",
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "page_type": {
          "type": "string",
          "description": "必須是 validate_slide_spec_gpts.py 之 PAGE_TYPES 註冊表中的鍵。本 enum 由 `template_admin.py sync-docs --write` 從 PAGE_TYPES 生成,不要手改——手改會在下次 sync-docs 被蓋掉,而且 pack 會先擋下來。",
          "enum": [
            "cover",
            "closing",
            "agenda",
            "section_transition",
            "vision_goal_center_balance",
            "info_three_column_category",
            "info_sidebar_grid",
            "data_line_trend_comparison",
            "data_two_group_metric_comparison",
            "evaluation_vs_criteria_matrix",
            "evaluation_option_score_pros_cons",
            "pyramid_layered_maturity_detail",
            "data_three_number_kpis",
            "info_horizontal_explanation_rows",
            "cycle_four_point_loop",
            "phase_three_column_action_cards",
            "stage_year_cards",
            "info_card_grid",
            "stage_timeline_progress",
            "info_before_after_item_compare",
            "vision_goal_keyword_orbit",
            "phase_concept_three_column_explanation",
            "vision_goal_rings",
            "stage_phase_swimlane",
            "stage_horizon_matrix",
            "stage_vertical_timeline_detail",
            "phase_four_step_workflow_matrix",
            "phase_step_ladder_cards",
            "vision_goal_pyramid",
            "cycle_three_node_process",
            "cycle_multi_step_loop",
            "stage_period_cards",
            "pyramid_three_level_center_explanation"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "render_page_number": {
          "type": "boolean"
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "background": {
              "type": "string"
            },
            "logo": {
              "type": "string"
            }
          }
        },
        "slots": {
          "type": "object",
          "description": "槽位形狀依 page_type 而定；深層規則（數量下上限、字數上限、來源追溯）在驗證器中執行。",
          "minProperties": 1
        }
      }
    }
  }
}
